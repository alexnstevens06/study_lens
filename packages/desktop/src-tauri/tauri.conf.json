{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Study Partner",
  "version": "0.1.0",
  "identifier": "com.studylens.partner",
  "build": {
    "beforeDevCommand": "npm run dev -w @study-lens/web --prefix ../..",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build -w @study-lens/web --prefix ../..",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Study Partner",
        "width": 1000,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ]
  }
}
